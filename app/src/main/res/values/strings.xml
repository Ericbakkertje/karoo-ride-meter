    <string name="settings_under_speed">Under the speed</string>
    <string name="settings_status">Above the dial</string>
    <string name="settings_status_left">Top left</string>
    <string name="settings_status_right">Top right</string>
    <string name="settings_dark_colors">Colours in dark mode</string>
