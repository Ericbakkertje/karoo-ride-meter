    <string name="settings_dark_colors_bright">Bright (stronger colours)</string>
    <string name="settings_light_note">The meter follows the Karoo light or dark mode. Light mode always uses the bright colours.</string>
    <string name="settings_ride_boxes">Round fields</string>
