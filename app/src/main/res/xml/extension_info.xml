<?xml version="1.0" encoding="utf-8"?>
<!-- id must match the extension id passed to KarooExtension in RideMeterExtension.kt -->
<ExtensionInfo
    displayName="@string/extension_name"
    icon="@drawable/ic_ride_meter"
    id="karoo-ride-meter"
    scansDevices="false"
    mapLayer="false"
    fitFile="false">

    <!-- Graphical fields: RideMeterDataType.startView draws the dial face with round fields.
         One field per DialValue (what the dial shows); typeIds must match DialValue.typeId. -->
    <DataType
        description="@string/ride_meter_description"
        displayName="@string/ride_meter_name"
        graphical="true"
        icon="@drawable/ic_ride_meter"
        typeId="ride-meter" />

    <DataType
        description="@string/ride_meter_power_description"
        displayName="@string/ride_meter_power_name"
        graphical="true"
        icon="@drawable/ic_ride_meter"
        typeId="ride-meter-power" />

    <DataType
        description="@string/ride_meter_power_3s_description"
        displayName="@string/ride_meter_power_3s_name"
        graphical="true"
        icon="@drawable/ic_ride_meter"
        typeId="ride-meter-power-3s" />

    <DataType
        description="@string/ride_meter_heart_rate_description"
        displayName="@string/ride_meter_heart_rate_name"
        graphical="true"
        icon="@drawable/ic_ride_meter"
        typeId="ride-meter-heart-rate" />

    <DataType
        description="@string/ride_meter_cadence_description"
        displayName="@string/ride_meter_cadence_name"
        graphical="true"
        icon="@drawable/ic_ride_meter"
        typeId="ride-meter-cadence" />

</ExtensionInfo>
